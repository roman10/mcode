# Gemini Code Assist OAuth credentials
#
# These are the public installed-app client credentials used by google-gemini/gemini-cli.
# They identify the application, not the user — user tokens live in ~/.gemini/oauth_creds.json.
#
# Setup:
#   cp .env.local.template .env.local
#   Fill in the values, then run `npm run dev` or `npm run build`.
#
# For CI / release builds, add these to .env.signing instead.
# Values can be found in the google-gemini/gemini-cli open-source repository.
GEMINI_OAUTH_CLIENT_ID=
GEMINI_OAUTH_CLIENT_SECRET=
